###############################################################
# ChatD Internships Bot - Test Environment Configuration
# Use for development and testing with ThatdInternships bot
###############################################################

###############################################################
# Discord Bot Configuration (Test Bot)
###############################################################

# Test Discord bot token (ThatdInternships bot)
DISCORD_TOKEN=your_test_discord_bot_token_here

# Test channel IDs (use your own test channels)
CHANNEL_IDS=your_test_channel_ids_here

###############################################################
# Repository Settings
###############################################################

REPO_URL=https://github.com/SimplifyJobs/Summer2026-Internships.git

###############################################################
# Database Configuration (Test Database)
###############################################################

# Test database password (isolated from production)
DB_PASSWORD=test_postgres_password

# Database migration mode
MIGRATION_MODE=database_only

# Test database connection settings
DB_TYPE=postgresql
DB_HOST=chatd-postgres-test
DB_PORT=5432
DB_NAME=chatd_test
DB_USER=chatd_test

###############################################################
# Performance Optimization Settings (Section 4.1)
###############################################################

# Optimized message posting delay (100ms vs 1000ms default)
MESSAGE_POST_DELAY_MS=100

# Optimized reaction delay (500ms - keeping existing setting)
REACTION_DELAY_MS=500

# Batch processing delay for async operations
BATCH_PROCESSING_DELAY_MS=50

###############################################################
# Reaction Batching & Rate Limiting (Section 4.3)
###############################################################

# Reaction batching configuration for testing
REACTION_BATCH_SIZE=3
REACTION_BATCH_DELAY_MS=500
REACTION_RETRY_COUNT=2
REACTION_RETRY_DELAY_MS=300

###############################################################
# Development/Testing Configuration
###############################################################

# Enable more verbose logging for development
LOG_LEVEL=DEBUG

# Enable reactions for testing
ENABLE_REACTIONS=true

# Faster checking for development (careful not to hit rate limits)
CHECK_INTERVAL_MINUTES=1

# Shorter age limit for testing
MAX_POST_AGE_DAYS=2

# Fewer retries for faster failure detection
MAX_RETRIES=2

###############################################################
# Development Database Settings
###############################################################

DB_CONNECTION_POOL_SIZE=3
DB_AUTO_VACUUM=true
DB_HEALTH_CHECK_INTERVAL=60
DB_MIGRATION_BATCH_SIZE=50
DB_BACKUP_RETENTION_DAYS=7